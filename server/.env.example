# Real Supabase project (used by the Vercel proxy — never expose DB URL in frontends)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Frontends should set:
# VITE_SUPABASE_URL=https://nfc-server-gamma.vercel.app
